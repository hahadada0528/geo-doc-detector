# 火山方舟 API Key（控制台申请）
ARK_API_KEY=your_ark_api_key_here

# 接入点/模型 ID（需已开通）；联网还需开通「联网内容插件」
ARK_MODEL=doubao-seed-evolving

# 方舟 Responses API 地址
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 提问间隔（秒），避免触发限流
ASK_INTERVAL_SEC=2

# 也可在网页「设置」中覆盖上述 ARK_* / ASK_INTERVAL_SEC（写入 data/app_settings.json）

# 写稿服务（Hermes FastAPI，OpenAI 兼容）
HERMES_BASE_URL=http://127.0.0.1:8080
HERMES_API_KEY=
HERMES_MODEL=wiki-assistant
# 需要更多上下文时可用：wiki-assistant-full
HERMES_TIMEOUT_SEC=300

# 知识库上传（POST /v1/files）
KB_BASE_URL=http://127.0.0.1:8686
KB_API_KEY=
KB_PURPOSE=brand-extras
KB_TIMEOUT_SEC=120
